rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email == "makaio.pluto@gmail.com";
    }

    // 버튜버 정보: 누구나 읽기 가능, 관리자만 전체 쓰기 가능
    // 단, "views"(조회수) 필드만 바꾸는 업데이트는 누구나 허용 (조회수 카운터용)
    match /vtubers/{vtuberId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["views"]);
    }

    // 즐겨찾기: 본인 것만 읽기/쓰기 가능
    match /users/{uid}/favorites/{vtuberId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 댓글: 누구나 읽기, 로그인한 사람만 본인 명의로 작성,
    // 본인 또는 관리자만 삭제. 좋아요/싫어요(votes)만 바꾸는 수정은 로그인한 사람 누구나 가능.
    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null &&
        (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["votes"]);
    }

    // 버튜버 추가 요청: 로그인한 사람은 본인 명의로 제출 가능,
    // 목록 조회/삭제는 관리자만 가능 (검토 후 처리)
    match /requests/{requestId} {
      allow read: if isAdmin();
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin();
      allow update: if false;
    }
  }
}
